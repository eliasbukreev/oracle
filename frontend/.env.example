# URL воркера (обязательно локально, иначе фронт покажет ошибку связи).
NUXT_PUBLIC_ORACLE_API_URL=https://oracle-worker.<account>.workers.dev

# Полный URL сайта для canonical/og:url. Необязательно:
# по умолчанию подставляется адрес на GitHub Pages.
NUXT_PUBLIC_SITE_URL=https://oracle.fivemanarmy.ru

# Base path приложения. Необязательно: по умолчанию "/" локально
# и "/<repo>/" в CI (из vars.SITE_BASE_PATH).
NUXT_APP_BASE_URL=/
